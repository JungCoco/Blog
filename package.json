{
    "name": "blog-monorepo",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
        "clean": "turbo run clean",
        "clean:cache": "rm -rf .turbo node_modules/.cache",
        "clean:all": "turbo run clean && rm -rf node_modules .turbo",
        "clean:dist": "turbo run clean:dist"
    },
    "devDependencies": {
        "prettier": "^3.8.1",
        "turbo": "^2.8.1",
        "typescript": "~5.9.3"
    },
    "packageManager": "pnpm@9.15.4",
    "engines": {
        "node": ">=20"
    }
}
