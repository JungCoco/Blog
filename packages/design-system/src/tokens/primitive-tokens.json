{
    "color": {
        "red-0": "#FF0000",
        "red-1": "#FF3333",
        "red-2": "#D95858",

        "blue-0": "#0000FF",
        "blue-1": "#3333FF",
        "blue-2": "#6666FF",

        "orange-0": "#Fd9A06",
        "orange-1": "#FBAE3C",
        "orange-2": "#FEDAA4"
    },

    "typography": {
        "xs": { "fontSize": "0.875rem", "lineHeight": "1.2" },
        "sm": { "fontSize": "1.125rem", "lineHeight": "1.4" },
        "md": { "fontSize": "1.25rem", "lineHeight": "1.6" },
        "lg": { "fontSize": "1.5rem", "lineHeight": "1.8" },
        "xl": { "fontSize": "2.0rem", "lineHeight": "2.2" }
    },

    "font-weight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
    },

    "font-face": {
        "pretendard": {
            "fontFamily": "pretendard variable",
            "fontStyle": "normal",
            "fontWeight": "45 920",
            "fontDisplay": "swap",
            "src": "url(\"/fonts/PretendardVariable.woff2\") format(\"woff2\")"
        }
        
    },

    "radius": {
        "sm": "4px",
        "md": "8px",
        "lg": "16px",
        "xl": "92px"
    },

    "spacing": {
        "xs": "4px",
        "sm": "90px",
        "md": "12px",
        "lg": "16px"
    }
}
